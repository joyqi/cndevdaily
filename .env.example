# OpenAI API Key
OPENAI_API_KEY=sk-xxx

# API 地址（可选，用于自定义 endpoint）与模型名
# OPENAI_API_BASE_URL=https://zenmux.ai/api/v1
# OPENAI_API_MODEL=deepseek/deepseek-v4-flash

# 写作专用模型（推荐语质量优先，用当前最好的写作模型）
# OPENAI_API_MODEL_WRITER=moonshotai/kimi-k3

# 评审专用模型（质量评审，用便宜可靠的 flash 级模型）
# OPENAI_API_MODEL_JUDGE=deepseek/deepseek-v4-flash

# Mastodon Configuration
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=xxx

# Set to true to skip Mastodon publishing (used in pnpm dev by default)
# DRY_RUN=true
